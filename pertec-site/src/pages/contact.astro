---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.astro';
---

<BaseLayout
  title="Contact | Demande de Devis Gratuit | Pertec.fr"
  description="Contactez-moi pour votre projet de création de site internet à Evreux. Devis gratuit sous 24h, sans engagement. Échange téléphonique ou visio possible."
>
  <section class="pt-32 pb-24 relative">
    <div class="container mx-auto px-6">
      <div class="max-w-6xl mx-auto">
        <div class="grid lg:grid-cols-2 gap-16">
          <!-- Left Column - Info -->
          <div>
            <div class="inline-flex items-center gap-2 px-4 py-2 mb-8 rounded-full glass" data-animate>
              <span class="w-2 h-2 bg-primary rounded-full animate-pulse"></span>
              <span class="text-sm text-gray-300">Contact</span>
            </div>

            <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6" data-animate>
              Parlons de<br /><span class="gradient-text">votre projet</span>
            </h1>

            <p class="text-xl text-gray-400 mb-12" data-animate>
              Une question ? Un projet en tête ? Contactez-moi pour en discuter.
              Je vous réponds sous 24h maximum.
            </p>

            <!-- Contact Info -->
            <div class="space-y-6 mb-12">
              <a
                href="mailto:contact@pertec.fr"
                class="flex items-center gap-4 p-4 glass rounded-xl hover:bg-white/10 transition-colors duration-300 group"
                data-animate
              >
                <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-primary to-accent flex items-center justify-center">
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-sm text-gray-400">Email</p>
                  <p class="text-white font-semibold group-hover:text-primary transition-colors">contact@pertec.fr</p>
                </div>
              </a>

              <div
                class="flex items-center gap-4 p-4 glass rounded-xl"
                data-animate
              >
                <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-primary to-accent flex items-center justify-center">
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-sm text-gray-400">Localisation</p>
                  <p class="text-white font-semibold">Evreux, Eure (27)</p>
                </div>
              </div>

              <div
                class="flex items-center gap-4 p-4 glass rounded-xl"
                data-animate
              >
                <div class="w-12 h-12 rounded-xl bg-gradient-to-br from-primary to-accent flex items-center justify-center">
                  <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                  </svg>
                </div>
                <div>
                  <p class="text-sm text-gray-400">Disponibilité</p>
                  <p class="text-white font-semibold">Lun - Ven · 9h - 18h</p>
                </div>
              </div>
            </div>

            <!-- Trust badges -->
            <div class="flex flex-wrap gap-4" data-animate>
              <div class="flex items-center gap-2 px-4 py-2 bg-green-500/10 border border-green-500/20 rounded-full">
                <svg class="w-5 h-5 text-green-500" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span class="text-sm text-green-400">Réponse sous 24h</span>
              </div>
              <div class="flex items-center gap-2 px-4 py-2 bg-primary/10 border border-primary/20 rounded-full">
                <svg class="w-5 h-5 text-primary" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M10 18a8 8 0 100-16 8 8 0 000 16zm3.707-9.293a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
                </svg>
                <span class="text-sm text-primary">Devis gratuit</span>
              </div>
            </div>
          </div>

          <!-- Right Column - Form -->
          <div class="glass-strong p-8 md:p-10 rounded-3xl glow" data-animate>
            <h2 class="text-2xl font-bold text-white mb-6">
              Demander un devis gratuit
            </h2>
            <ContactForm />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Map Section -->
  <section class="py-24 relative">
    <div class="container mx-auto px-6">
      <div class="glass-strong rounded-3xl overflow-hidden" data-animate>
        <div class="aspect-[21/9] bg-gradient-to-br from-primary/20 to-accent/20 flex items-center justify-center relative">
          <!-- Decorative map placeholder -->
          <div class="absolute inset-0 grid-pattern opacity-50"></div>
          <div class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2">
            <div class="w-6 h-6 bg-primary rounded-full animate-ping absolute"></div>
            <div class="w-6 h-6 bg-primary rounded-full relative z-10 flex items-center justify-center">
              <div class="w-3 h-3 bg-white rounded-full"></div>
            </div>
          </div>
          <div class="relative z-10 text-center px-8">
            <div class="text-6xl mb-4">📍</div>
            <p class="text-2xl font-bold text-white mb-2">Evreux</p>
            <p class="text-gray-400">Eure (27) · Normandie · France</p>
            <p class="text-sm text-gray-500 mt-4">Rendez-vous possibles sur place ou en visioconférence</p>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
