---
import BaseLayout from '../layouts/BaseLayout.astro';

const eure = [
  { name: 'Evreux', main: true },
  { name: 'Louviers' },
  { name: 'Vernon' },
  { name: 'Bernay' },
  { name: 'Pont-Audemer' },
  { name: 'Val-de-Reuil' },
  { name: 'Gisors' },
  { name: 'Les Andelys' },
  { name: 'Gaillon' },
  { name: 'Brionne' },
  { name: 'Conches-en-Ouche' },
  { name: 'Pacy-sur-Eure' },
];

const departements = [
  { code: '78', name: 'Yvelines', villes: ['Mantes-la-Jolie', 'Poissy', 'Les Mureaux'] },
  { code: '28', name: 'Eure-et-Loir', villes: ['Dreux', 'Chartres', 'Vernouillet'] },
  { code: '76', name: 'Seine-Maritime', villes: ['Rouen', 'Elbeuf', 'Sotteville'] },
  { code: '61', name: 'Orne', villes: ['L\'Aigle', 'Verneuil-sur-Avre'] },
];
---

<BaseLayout
  title="Zone d'Intervention | Création Sites Internet Eure & Normandie | Pertec.fr"
  description="Création de sites internet à Evreux, Louviers, Vernon, Bernay et dans tout le département de l'Eure. Intervention en Normandie et départements limitrophes."
>
  <!-- Hero -->
  <section class="pt-32 pb-16 relative">
    <div class="container mx-auto px-6">
      <div class="max-w-4xl mx-auto text-center">
        <div class="inline-flex items-center gap-2 px-4 py-2 mb-8 rounded-full glass" data-animate>
          <span class="text-2xl">📍</span>
          <span class="text-sm text-gray-300">Zone d'intervention</span>
        </div>

        <h1 class="section-title mb-6" data-animate>
          J'interviens dans tout<br /><span class="gradient-text">l'Eure</span> et au-delà
        </h1>

        <p class="text-xl text-gray-400 max-w-2xl mx-auto" data-animate>
          Basé à Evreux, je me déplace pour rencontrer mes clients ou travaille en visioconférence.
          Un vrai interlocuteur local, disponible et réactif.
        </p>
      </div>
    </div>
  </section>

  <!-- Map Visual -->
  <section class="py-16">
    <div class="container mx-auto px-6">
      <div class="max-w-4xl mx-auto">
        <div class="glass-strong rounded-3xl p-8 md:p-12" data-animate>
          <div class="aspect-video bg-gradient-to-br from-primary/20 to-accent/20 rounded-2xl flex items-center justify-center relative overflow-hidden">
            <!-- Grid Pattern -->
            <div class="absolute inset-0 grid-pattern opacity-50"></div>

            <!-- Central marker -->
            <div class="relative">
              <div class="absolute -inset-8">
                <div class="w-full h-full border-2 border-primary/30 rounded-full animate-ping" style="animation-duration: 2s;"></div>
              </div>
              <div class="absolute -inset-16">
                <div class="w-full h-full border border-primary/20 rounded-full animate-ping" style="animation-duration: 3s;"></div>
              </div>
              <div class="w-16 h-16 bg-gradient-to-br from-primary to-accent rounded-full flex items-center justify-center relative z-10 shadow-lg shadow-primary/50">
                <svg class="w-8 h-8 text-white" fill="currentColor" viewBox="0 0 20 20">
                  <path fill-rule="evenodd" d="M5.05 4.05a7 7 0 119.9 9.9L10 18.9l-4.95-4.95a7 7 0 010-9.9zM10 11a2 2 0 100-4 2 2 0 000 4z" clip-rule="evenodd"/>
                </svg>
              </div>
            </div>

            <!-- Info overlay -->
            <div class="absolute bottom-6 left-6 right-6 flex justify-between items-end">
              <div>
                <p class="text-3xl font-bold text-white">Evreux</p>
                <p class="text-gray-400">Siège · Eure (27)</p>
              </div>
              <div class="text-right">
                <p class="text-sm text-gray-400">Rayon d'intervention</p>
                <p class="text-xl font-bold text-primary">~100 km</p>
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Eure -->
  <section class="py-24 relative">
    <div class="container mx-auto px-6">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold mb-8 text-center" data-animate>
          <span class="gradient-text">Eure (27)</span> — Zone principale
        </h2>

        <div class="grid grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-4">
          {eure.map((ville, index) => (
            <div
              class={`p-4 rounded-xl text-center transition-all duration-300 hover:-translate-y-1
                ${ville.main
                  ? 'bg-gradient-to-br from-primary to-accent text-white font-bold'
                  : 'glass hover:bg-white/10'
                }`}
              data-animate
              style={`animation-delay: ${index * 50}ms`}
            >
              {ville.main && <span class="text-xs block mb-1 opacity-80">📍 Siège</span>}
              {ville.name}
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Départements limitrophes -->
  <section class="py-24 relative bg-gradient-to-b from-primary/5 via-transparent to-transparent">
    <div class="container mx-auto px-6">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold mb-12 text-center" data-animate>
          Départements <span class="gradient-text">limitrophes</span>
        </h2>

        <div class="grid md:grid-cols-2 gap-6">
          {departements.map((dept, index) => (
            <div
              class="glass p-6 rounded-2xl"
              data-animate
              style={`animation-delay: ${index * 100}ms`}
            >
              <div class="flex items-center gap-3 mb-4">
                <div class="w-10 h-10 rounded-xl bg-gradient-to-br from-primary/20 to-accent/20 flex items-center justify-center font-bold text-primary">
                  {dept.code}
                </div>
                <h3 class="text-lg font-bold text-white">{dept.name}</h3>
              </div>
              <div class="flex flex-wrap gap-2">
                {dept.villes.map((ville) => (
                  <span class="px-3 py-1 bg-white/5 rounded-full text-sm text-gray-400">
                    {ville}
                  </span>
                ))}
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Modes de travail -->
  <section class="py-24 relative">
    <div class="container mx-auto px-6">
      <div class="max-w-4xl mx-auto">
        <h2 class="text-3xl font-bold mb-12 text-center" data-animate>
          Comment <span class="gradient-text">travaillons-nous</span> ?
        </h2>

        <div class="grid md:grid-cols-2 gap-6">
          <div class="glass p-8 rounded-2xl" data-animate>
            <div class="text-4xl mb-4">🤝</div>
            <h3 class="text-xl font-bold text-white mb-3">En présentiel</h3>
            <p class="text-gray-400">
              Je me déplace chez vous ou on se retrouve autour d'un café pour discuter de votre projet.
              Idéal pour les clients de l'Eure.
            </p>
          </div>

          <div class="glass p-8 rounded-2xl" data-animate>
            <div class="text-4xl mb-4">💻</div>
            <h3 class="text-xl font-bold text-white mb-3">En visioconférence</h3>
            <p class="text-gray-400">
              Pour les clients plus éloignés, nos échanges se font par visio (Google Meet, Zoom...).
              Tout aussi efficace !
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 relative">
    <div class="absolute inset-0 bg-gradient-to-b from-primary/10 via-accent/5 to-transparent"></div>

    <div class="container mx-auto px-6 relative z-10">
      <div class="max-w-3xl mx-auto text-center">
        <h2 class="section-title mb-6" data-animate>
          Vous êtes dans <span class="gradient-text">ma zone</span> ?
        </h2>
        <p class="text-xl text-gray-400 mb-8" data-animate>
          Contactez-moi pour discuter de votre projet. Premier échange gratuit !
        </p>

        <a href="/contact" class="btn-primary" data-animate>
          <span>Prendre contact</span>
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
