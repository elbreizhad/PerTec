---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContactForm from '../../components/ContactForm.astro';
import TestimonialCard from '../../components/TestimonialCard.astro';

const avantages = [
  {
    icon: '🔍',
    title: 'Être trouvé sur Google',
    description: 'Quand quelqu\'un cherche "plombier Evreux" ou "électricien Louviers", votre site apparaît dans les premiers résultats.'
  },
  {
    icon: '📱',
    title: 'Présent 24h/24',
    description: 'Vos services, vos réalisations et vos coordonnées accessibles à tout moment, même quand vous êtes sur un chantier.'
  },
  {
    icon: '📸',
    title: 'Montrer vos réalisations',
    description: 'Une galerie photos de vos chantiers pour rassurer vos futurs clients et démontrer votre savoir-faire.'
  },
  {
    icon: '📝',
    title: 'Recevoir des demandes',
    description: 'Formulaire de devis en ligne personnalisé pour votre métier. Les demandes arrivent directement par email.'
  },
  {
    icon: '⭐',
    title: 'Crédibilité',
    description: 'Un site professionnel inspire confiance. Vous vous démarquez de la concurrence qui n\'a que Facebook.'
  },
  {
    icon: '📍',
    title: 'Zone d\'intervention',
    description: 'Affichez clairement les villes où vous intervenez pour attirer les bons clients.'
  },
];

const inclus = [
  'Page Accueil avec présentation',
  'Page Services détaillés',
  'Galerie photos de réalisations',
  'Formulaire de devis personnalisé',
  'Page Zone d\'intervention',
  'Témoignages clients',
  'Optimisation SEO local',
  'Google Business Profile',
];

const metiers = [
  'Plombier', 'Électricien', 'Maçon', 'Peintre', 'Menuisier',
  'Couvreur', 'Carreleur', 'Chauffagiste', 'Serrurier', 'Vitrier'
];

const testimonial = {
  name: 'Marc D.',
  role: 'Plombier chauffagiste',
  location: 'Louviers',
  quote: 'Depuis que j\'ai mon site, je reçois 3 à 4 demandes de devis par semaine. Le meilleur investissement que j\'ai fait pour mon activité !',
  rating: 5
};
---

<BaseLayout
  title="Site Internet pour Artisan à Evreux | Plombier, Électricien, Maçon | Pertec.fr"
  description="Création de site internet pour artisans à Evreux et dans l'Eure. Site vitrine professionnel avec formulaire devis, galerie photos, SEO local. Devis gratuit."
>
  <!-- Hero -->
  <section class="pt-32 pb-16 relative overflow-hidden">
    <!-- Background decoration -->
    <div class="absolute top-20 right-0 w-96 h-96 bg-primary/10 rounded-full blur-3xl"></div>

    <div class="container mx-auto px-6 relative z-10">
      <div class="max-w-4xl">
        <div class="inline-flex items-center gap-2 px-4 py-2 mb-8 rounded-full glass" data-animate>
          <span class="text-2xl">🔧</span>
          <span class="text-sm text-gray-300">Sites pour artisans</span>
        </div>

        <h1 class="text-4xl md:text-5xl lg:text-6xl font-bold mb-6" data-animate>
          Création de site internet<br />
          <span class="gradient-text">pour artisans</span> à Evreux
        </h1>

        <p class="text-xl text-gray-400 mb-8 max-w-2xl" data-animate>
          Plombier, électricien, maçon, peintre... Développez votre activité
          avec un site web professionnel qui vous apporte des clients.
        </p>

        <div class="flex flex-wrap gap-4" data-animate>
          <a href="/contact" class="btn-primary">
            <span>Devis gratuit artisan</span>
          </a>
          <a href="/realisations" class="btn-secondary">
            <span>Voir des exemples</span>
          </a>
        </div>

        <!-- Métiers -->
        <div class="mt-12 flex flex-wrap gap-3" data-animate>
          {metiers.map((metier) => (
            <span class="px-4 py-2 glass rounded-full text-sm text-gray-300">
              {metier}
            </span>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- Pourquoi un site -->
  <section class="py-24 relative">
    <div class="container mx-auto px-6">
      <div class="text-center mb-16">
        <h2 class="section-title mb-6" data-animate>
          Pourquoi un site pour <span class="gradient-text">artisan</span> ?
        </h2>
        <p class="section-subtitle mx-auto" data-animate>
          Un site internet professionnel, c'est votre meilleur commercial. Il travaille pour vous 24h/24.
        </p>
      </div>

      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6 max-w-6xl mx-auto">
        {avantages.map((item, index) => (
          <div
            class="glass p-6 rounded-2xl hover:bg-white/10 transition-all duration-300"
            data-animate
            style={`animation-delay: ${index * 100}ms`}
          >
            <div class="text-3xl mb-4">{item.icon}</div>
            <h3 class="text-lg font-bold text-white mb-2">{item.title}</h3>
            <p class="text-gray-400 text-sm">{item.description}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Ce qui est inclus -->
  <section class="py-24 relative bg-gradient-to-b from-primary/5 via-transparent to-transparent">
    <div class="container mx-auto px-6">
      <div class="grid lg:grid-cols-2 gap-16 items-center max-w-6xl mx-auto">
        <div>
          <h2 class="text-3xl md:text-4xl font-bold mb-6" data-animate>
            Ce qui est <span class="gradient-text">inclus</span> pour les artisans
          </h2>

          <p class="text-gray-400 mb-8" data-animate>
            Un site complet, optimisé pour votre métier, avec tout ce qu'il faut
            pour recevoir des demandes de devis.
          </p>

          <ul class="space-y-4">
            {inclus.map((item, index) => (
              <li
                class="flex items-center gap-3"
                data-animate
                style={`animation-delay: ${index * 50}ms`}
              >
                <div class="w-6 h-6 rounded-full bg-gradient-to-br from-primary to-accent flex items-center justify-center flex-shrink-0">
                  <svg class="w-4 h-4 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
                  </svg>
                </div>
                <span class="text-white">{item}</span>
              </li>
            ))}
          </ul>
        </div>

        <div class="relative" data-animate>
          <div class="glass-strong p-8 rounded-3xl">
            <TestimonialCard {...testimonial} />
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="py-24 relative">
    <div class="container mx-auto px-6">
      <div class="max-w-3xl mx-auto">
        <h2 class="text-3xl md:text-4xl font-bold mb-12 text-center" data-animate>
          Questions <span class="gradient-text">fréquentes</span>
        </h2>

        <div class="space-y-4">
          <details class="group glass rounded-2xl overflow-hidden" data-animate>
            <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
              <h3 class="font-semibold text-white pr-4">Combien coûte un site pour artisan ?</h3>
              <span class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center flex-shrink-0 transition-transform duration-300 group-open:rotate-45">
                <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
              </span>
            </summary>
            <div class="px-6 pb-6 text-gray-400">
              Le tarif dépend de vos besoins (nombre de pages, fonctionnalités...). Contactez-moi pour un devis personnalisé gratuit et sans engagement.
            </div>
          </details>

          <details class="group glass rounded-2xl overflow-hidden" data-animate>
            <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
              <h3 class="font-semibold text-white pr-4">Puis-je ajouter mes photos de chantiers ?</h3>
              <span class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center flex-shrink-0 transition-transform duration-300 group-open:rotate-45">
                <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
              </span>
            </summary>
            <div class="px-6 pb-6 text-gray-400">
              Bien sûr ! Une galerie photos est incluse. Vous pourrez facilement ajouter vos nouvelles réalisations.
              Je vous forme à la gestion de cette galerie.
            </div>
          </details>

          <details class="group glass rounded-2xl overflow-hidden" data-animate>
            <summary class="flex items-center justify-between p-6 cursor-pointer list-none">
              <h3 class="font-semibold text-white pr-4">Comment recevoir des demandes de devis ?</h3>
              <span class="w-8 h-8 rounded-full bg-white/5 flex items-center justify-center flex-shrink-0 transition-transform duration-300 group-open:rotate-45">
                <svg class="w-4 h-4 text-primary" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"/>
                </svg>
              </span>
            </summary>
            <div class="px-6 pb-6 text-gray-400">
              Un formulaire de devis personnalisé est intégré à votre site. Les demandes arrivent directement
              dans votre boîte email avec toutes les informations du client (nom, téléphone, description du besoin...).
            </div>
          </details>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="py-24 relative">
    <div class="absolute inset-0 bg-gradient-to-b from-primary/10 via-accent/5 to-transparent"></div>

    <div class="container mx-auto px-6 relative z-10">
      <div class="max-w-4xl mx-auto">
        <div class="text-center mb-12">
          <h2 class="section-title mb-6" data-animate>
            Prêt à développer <span class="gradient-text">votre activité</span> ?
          </h2>
          <p class="section-subtitle mx-auto" data-animate>
            Demandez votre devis gratuit. Je vous réponds sous 24h.
          </p>
        </div>

        <div class="glass-strong p-8 md:p-12 rounded-3xl glow" data-animate>
          <ContactForm compact />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
