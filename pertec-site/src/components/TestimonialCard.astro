---
interface Props {
  name: string;
  role: string;
  location: string;
  quote: string;
  rating?: number;
  index?: number;
}

const { name, role, location, quote, rating = 5, index = 0 } = Astro.props;
---

<div
  class="group relative p-8 glass card-hover"
  data-animate
  style={`animation-delay: ${index * 100}ms`}
>
  <!-- Quote Icon -->
  <div class="absolute -top-4 -left-2 text-6xl text-primary/20 font-serif">"</div>

  <!-- Stars -->
  <div class="flex gap-1 mb-4">
    {Array.from({ length: 5 }).map((_, i) => (
      <svg
        class={`w-5 h-5 ${i < rating ? 'text-yellow-400' : 'text-gray-600'}`}
        fill="currentColor"
        viewBox="0 0 20 20"
      >
        <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
      </svg>
    ))}
  </div>

  <!-- Quote -->
  <p class="text-lg text-gray-300 leading-relaxed mb-6 relative z-10">
    "{quote}"
  </p>

  <!-- Author -->
  <div class="flex items-center gap-4">
    <!-- Avatar -->
    <div class="w-12 h-12 rounded-full bg-gradient-to-br from-primary to-accent flex items-center justify-center text-white font-bold">
      {name.split(' ').map(n => n[0]).join('')}
    </div>

    <div>
      <p class="font-semibold text-white">{name}</p>
      <p class="text-sm text-gray-400">{role} · {location}</p>
    </div>
  </div>
</div>
