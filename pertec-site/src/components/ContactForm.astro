---
interface Props {
  compact?: boolean;
}

const { compact = false } = Astro.props;
---

<form
  action="https://formspree.io/f/your-form-id"
  method="POST"
  class="space-y-6"
  id="contact-form"
>
  <div class={`grid gap-6 ${compact ? 'grid-cols-1' : 'md:grid-cols-2'}`}>
    <!-- Nom -->
    <div class="group">
      <label for="nom" class="block text-sm font-medium text-gray-300 mb-2">
        Nom et prénom <span class="text-primary">*</span>
      </label>
      <input
        type="text"
        id="nom"
        name="nom"
        required
        class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-xl
               text-white placeholder-gray-500
               transition-all duration-300
               focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20
               hover:border-white/20"
        placeholder="Jean Dupont"
      />
    </div>

    <!-- Entreprise -->
    <div class="group">
      <label for="entreprise" class="block text-sm font-medium text-gray-300 mb-2">
        Entreprise / Activité <span class="text-primary">*</span>
      </label>
      <input
        type="text"
        id="entreprise"
        name="entreprise"
        required
        class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-xl
               text-white placeholder-gray-500
               transition-all duration-300
               focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20
               hover:border-white/20"
        placeholder="Plomberie Dupont"
      />
    </div>

    <!-- Email -->
    <div class="group">
      <label for="email" class="block text-sm font-medium text-gray-300 mb-2">
        Email <span class="text-primary">*</span>
      </label>
      <input
        type="email"
        id="email"
        name="email"
        required
        class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-xl
               text-white placeholder-gray-500
               transition-all duration-300
               focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20
               hover:border-white/20"
        placeholder="jean@exemple.fr"
      />
    </div>

    <!-- Téléphone -->
    <div class="group">
      <label for="telephone" class="block text-sm font-medium text-gray-300 mb-2">
        Téléphone <span class="text-primary">*</span>
      </label>
      <input
        type="tel"
        id="telephone"
        name="telephone"
        required
        class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-xl
               text-white placeholder-gray-500
               transition-all duration-300
               focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20
               hover:border-white/20"
        placeholder="06 12 34 56 78"
      />
    </div>
  </div>

  {!compact && (
    <div class="grid gap-6 md:grid-cols-2">
      <!-- Ville -->
      <div class="group">
        <label for="ville" class="block text-sm font-medium text-gray-300 mb-2">
          Ville
        </label>
        <input
          type="text"
          id="ville"
          name="ville"
          class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-xl
                 text-white placeholder-gray-500
                 transition-all duration-300
                 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20
                 hover:border-white/20"
          placeholder="Evreux"
        />
      </div>

      <!-- Type de projet -->
      <div class="group">
        <label for="projet" class="block text-sm font-medium text-gray-300 mb-2">
          Type de projet
        </label>
        <select
          id="projet"
          name="projet"
          class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-xl
                 text-white
                 transition-all duration-300
                 focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20
                 hover:border-white/20
                 appearance-none cursor-pointer"
          style="background-image: url('data:image/svg+xml;charset=UTF-8,%3csvg xmlns=%27http://www.w3.org/2000/svg%27 viewBox=%270 0 24 24%27 fill=%27none%27 stroke=%27%239ca3af%27 stroke-width=%272%27 stroke-linecap=%27round%27 stroke-linejoin=%27round%27%3e%3cpolyline points=%276 9 12 15 18 9%27%3e%3c/polyline%3e%3c/svg%3e'); background-repeat: no-repeat; background-position: right 1rem center; background-size: 1em;"
        >
          <option value="">Sélectionnez une option</option>
          <option value="creation">Création de site</option>
          <option value="refonte">Refonte de site existant</option>
          <option value="maintenance">Maintenance / Support</option>
          <option value="autre">Autre</option>
        </select>
      </div>
    </div>
  )}

  <!-- Message -->
  <div class="group">
    <label for="message" class="block text-sm font-medium text-gray-300 mb-2">
      Décrivez votre projet <span class="text-primary">*</span>
    </label>
    <textarea
      id="message"
      name="message"
      rows={compact ? "3" : "5"}
      required
      class="w-full px-4 py-3 bg-white/5 border border-white/10 rounded-xl
             text-white placeholder-gray-500
             transition-all duration-300
             focus:outline-none focus:border-primary focus:ring-2 focus:ring-primary/20
             hover:border-white/20
             resize-none"
      placeholder="Parlez-moi de votre projet, vos besoins, vos objectifs..."
    ></textarea>
  </div>

  <!-- Consent -->
  <div class="flex items-start gap-3">
    <input
      type="checkbox"
      id="consent"
      name="consent"
      required
      class="mt-1 w-5 h-5 bg-white/5 border border-white/10 rounded
             text-primary
             focus:ring-2 focus:ring-primary/20
             cursor-pointer"
    />
    <label for="consent" class="text-sm text-gray-400 cursor-pointer">
      J'accepte d'être recontacté concernant ma demande. <span class="text-primary">*</span>
    </label>
  </div>

  <!-- Submit Button -->
  <button
    type="submit"
    class="w-full btn-primary group"
  >
    <span class="flex items-center justify-center gap-2">
      Envoyer ma demande
      <svg class="w-5 h-5 transform group-hover:translate-x-1 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
      </svg>
    </span>
  </button>

  <!-- Trust -->
  <p class="text-center text-sm text-gray-500 flex items-center justify-center gap-2">
    <svg class="w-4 h-4 text-green-500" fill="currentColor" viewBox="0 0 20 20">
      <path fill-rule="evenodd" d="M2.166 4.999A11.954 11.954 0 0010 1.944 11.954 11.954 0 0017.834 5c.11.65.166 1.32.166 2.001 0 5.225-3.34 9.67-8 11.317C5.34 16.67 2 12.225 2 7c0-.682.057-1.35.166-2.001zm11.541 3.708a1 1 0 00-1.414-1.414L9 10.586 7.707 9.293a1 1 0 00-1.414 1.414l2 2a1 1 0 001.414 0l4-4z" clip-rule="evenodd"/>
    </svg>
    Réponse sous 24h · Devis gratuit et sans engagement
  </p>
</form>

<script>
  const form = document.getElementById('contact-form');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const button = form.querySelector('button[type="submit"]');
    const originalText = button?.innerHTML;

    if (button) {
      button.innerHTML = '<span class="flex items-center justify-center gap-2"><svg class="w-5 h-5 animate-spin" fill="none" viewBox="0 0 24 24"><circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle><path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8V0C5.373 0 0 5.373 0 12h4zm2 5.291A7.962 7.962 0 014 12H0c0 3.042 1.135 5.824 3 7.938l3-2.647z"></path></svg>Envoi en cours...</span>';
      button.disabled = true;
    }

    try {
      const formData = new FormData(form as HTMLFormElement);
      const response = await fetch(form.action, {
        method: 'POST',
        body: formData,
        headers: { 'Accept': 'application/json' }
      });

      if (response.ok) {
        form.innerHTML = `
          <div class="text-center py-12">
            <div class="w-16 h-16 mx-auto mb-6 rounded-full bg-green-500/20 flex items-center justify-center">
              <svg class="w-8 h-8 text-green-500" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/>
              </svg>
            </div>
            <h3 class="text-2xl font-bold text-white mb-2">Message envoyé !</h3>
            <p class="text-gray-400">Merci pour votre demande. Je vous recontacte sous 24h.</p>
          </div>
        `;
      } else {
        throw new Error('Erreur lors de l\'envoi');
      }
    } catch (error) {
      if (button) {
        button.innerHTML = originalText || '';
        button.disabled = false;
      }
      alert('Une erreur est survenue. Veuillez réessayer.');
    }
  });
</script>
